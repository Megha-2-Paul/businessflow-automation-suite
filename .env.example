# Copy this file to .env for local development.
BUSINESSFLOW_APP_NAME=BusinessFlow Automation Suite
BUSINESSFLOW_ENVIRONMENT=development
# SQLite is the default. PostgreSQL requires: pip install -e ".[postgres]"
BUSINESSFLOW_DATABASE_URL=sqlite:///data/businessflow.db
BUSINESSFLOW_LOG_LEVEL=INFO
BUSINESSFLOW_MAX_UPLOAD_MB=25
BUSINESSFLOW_STORAGE_DIR=storage
